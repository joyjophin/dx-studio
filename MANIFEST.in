include LICENSE THIRD_PARTY_NOTICES.md README.md SKILL.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
include launch.sh Launch*.command
recursive-include dx_studio *.py *.html *.js *.css *.ttf *.txt *.json
recursive-include docs *.md *.svg *.png *.jpg *.gif *.json
recursive-include reference *.md
recursive-include kits *.py
recursive-include scripts *.py *.sh
recursive-include tests *.py *.cjs
prune **/__pycache__
global-exclude *.pyc .DS_Store
